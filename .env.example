# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.

# desenvolvimento | teste | producao
AMBIENTE=desenvolvimento

# Obrigatória em produção (32+ caracteres). Para gerar:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite no computador; PostgreSQL no Docker/produção.
DATABASE_URL=sqlite:///./dados/validade.db

# ---------- IA que lê a data na foto (todas com uso gratuito) ----------
# Ordem de tentativa. Se uma falhar (ex.: acabou o limite grátis do dia), a próxima assume.
# Só entram as que estiverem preenchidas abaixo. Nenhuma preenchida = a pessoa digita a data.
IA_PROVEDORES=gemini,groq,ollama

# Gemini (Google): chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# Groq: chave grátis em https://console.groq.com/keys
# Confira em https://console.groq.com/docs/vision qual modelo lê imagens hoje.
GROQ_API_KEY=
GROQ_MODELO=qwen/qwen3.8-27b

# Ollama: IA rodando no seu próprio computador (grátis para sempre, sem limite).
# Instale em https://ollama.com e rode: ollama pull qwen2.5vl:7b
OLLAMA_URL=
OLLAMA_MODELO=qwen2.5vl:7b

# Abaixo disso, a leitura vai para revisão mesmo tendo lido uma data.
IA_CONFIANCA_MINIMA=0.75

# true = o worker roda junto com o servidor (prático no computador).
# No Docker o worker é um processo separado e isso fica false.
WORKER_EMBUTIDO=true
